{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "schedule": ["before 4am on monday"],
  "timezone": "UTC",
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "allowedVersions": "~1.25.0",
      "description": "Pin Go version to 1.25.x to match CI configuration"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepNames": ["actions/go-versions"],
      "allowedVersions": "~1.25.0",
      "description": "Pin Go version to 1.25.x in CI workflows"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchDepNames": ["npm"],
      "enabled": false,
      "description": "engines.npm tracks the npm bundled with the Node pinned in mise.toml; bump it with that pin, not independently"
    },
    {
      "groupName": "gRPC and protobuf dependencies",
      "groupSlug": "grpc-protobuf",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^google\\.golang\\.org//"]
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["google.golang.org/grpc"],
      "allowedVersions": "!/^v?1\\.84\\.0$/",
      "description": "Skip grpc v1.84.0, affected by GO-2026-6443; remove once a stable release contains the fix"
    },
    {
      "groupName": "GitHub dependencies",
      "groupSlug": "github-deps",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^github\\.com//"]
    },
    {
      "groupName": "Go x packages",
      "groupSlug": "go-x-packages",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^golang\\.org/x//"]
    },
    {
      "groupName": "Buf dependencies",
      "groupSlug": "buf-deps",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^buf\\.build//"]
    },
    {
      "groupName": "NPM dev dependencies",
      "groupSlug": "npm-dev",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"]
    },
    {
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "matchManagers": ["github-actions"]
    }
  ],
  "enabledManagers": ["gomod", "npm", "github-actions"],
  "gomod": {
    "enabled": true,
    "postUpdateOptions": ["gomodTidy"]
  },
  "ignorePaths": ["examples/**"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "commitMessageAction": "Update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "commitMessagePrefix": "chore(deps):",
  "commitMessageSuffix": "",
  "recreateWhen": "auto",
  "rebaseWhen": "auto",
  "rebaseLabel": "rebase",
  "assignees": [],
  "reviewers": [],
  "labels": ["dependencies", "renovate"],
  "assignAutomerge": false,
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "auto",
  "platformAutomerge": false,
  "hostRules": [],
  "configMigration": true,
  "gitAuthor": "Renovate Bot <bot@renovateapp.com>"
}
