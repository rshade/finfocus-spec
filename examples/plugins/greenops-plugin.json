{
  "metadata": {
    "name": "greenops-plugin",
    "version": "1.0.0",
    "description": "Specialized plugin for GreenOps and sustainability tracking, providing carbon footprint, energy consumption, and water usage metrics alongside cost data.",
    "author": "GreenOps Team",
    "license": "Apache-2.0",
    "keywords": ["greenops", "sustainability", "carbon", "energy", "water"],
    "created_at": "2025-12-18T10:00:00Z"
  },
  "specification": {
    "spec_version": "1.0.0",
    "supported_providers": ["aws", "gcp", "azure"],
    "capabilities": [
      "projected_costs", "carbon", "energy", "water", "dry_run"
    ],
    "service_definition": {
      "service_name": "CostSourceService",
      "package_name": "finfocus.v1",
      "methods": ["Name", "Supports", "GetProjectedCost", "GetPluginInfo", "DryRun"],
      "port": 50055,
      "health_check_path": "/health"
    }
  },
  "installation": {
    "installation_method": "binary",
    "download_url": "https://releases.finfocus.dev/greenops-plugin/v1.0.0/greenops-plugin-linux-amd64.tar.gz",
