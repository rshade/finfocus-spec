{
  "name": "finfocus-middleware",
  "version": "0.1.0",
  "description": "FinFocus REST API middleware for Node.js",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && tsc --emitDeclarationOnly -p tsconfig.build.json && tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@rshade/finfocus-client": "*"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsup": "^8.5.1"
  },
  "files": [
    "dist"
  ]
}
